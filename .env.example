# --- Database (Neon Postgres via Vercel Marketplace; Vercel fills this in automatically) ---
DATABASE_URL=

# --- Ingestion ---
# Long random string. Vercel Cron and the GitHub Action send it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Optional: raises GitHub API rate limits when listing ccfddl files (fine-grained token, public read only)
GITHUB_TOKEN=
ENABLE_LLM_TAGGING=false

# --- AI assistant ---
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Max chat messages per hour (cost guard)
CHAT_RATE_LIMIT_PER_HOUR=30

# --- Owner access gate ---
APP_PASSWORD=
# Long random string used to sign the unlock cookie
AUTH_SECRET=

# --- App ---
NEXT_PUBLIC_SITE_URL=https://findress.vercel.app
DEFAULT_TIMEZONE=Asia/Kolkata
