# --- Database (Neon Postgres via Vercel Marketplace; Vercel fills this in automatically) ---
# Local dev without Neon: run `pnpm db:local` and use
#   postgres://postgres:findress@localhost:54329/findress
DATABASE_URL=
# Optional: max pooled connections per server instance (default 5)
DB_POOL_MAX=5

# --- Ingestion ---
# Long random string. Vercel Cron and the GitHub Action send it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Optional: raises GitHub API rate limits when listing ccfddl files (fine-grained token, public read only)
GITHUB_TOKEN=
# Optional LLM topic tagging for events the keyword rules can't classify (uses the AI provider below)
ENABLE_LLM_TAGGING=false

# --- AI assistant ---
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Max chat messages per hour (cost guard)
CHAT_RATE_LIMIT_PER_HOUR=30
# Max output tokens per assistant answer (cost guard)
CHAT_MAX_OUTPUT_TOKENS=1500

# --- Owner access gate ---
APP_PASSWORD=
# Long random string used to sign the unlock cookie
AUTH_SECRET=

# --- App ---
# Public URL of the deployment (fallback: https://findress.vercel.app)
NEXT_PUBLIC_SITE_URL=https://findress.vercel.app
# Default display timezone for deadlines (viewer can change it in the UI)
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
