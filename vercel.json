{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm vercel-build",
  "crons": [
    {
      "path": "/api/ingest",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/ingest?source=journals,journal-ranks,journal-pages,special-issues",
      "schedule": "30 5 * * *"
    }
  ]
}
